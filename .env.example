# Salin file ini menjadi .env lalu isi API key-nya

# Pilih penyedia AI: gemini (ada kuota gratis) atau anthropic (Claude)
AI_PROVIDER=gemini

# Gemini — ambil API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Batas total AI; tiap model Gemini dicoba maksimal 12 detik, paling banyak 2 model
AI_TIMEOUT_MS=45000

# Claude — ambil API key di https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ===== Login WhatsApp =====
# Nomor WhatsApp bot. Diisi → login TANPA QR (kode tautan 8 karakter). Kosongkan → scan QR.
PAIRING_NUMBER=
# Halaman web untuk melihat QR / kode tautan: http://IP-VPS:3000/?token=PANEL_TOKEN (0 = mati)
PANEL_PORT=3000
# Sandi halaman web. Buat acak: openssl rand -hex 12
PANEL_TOKEN=
# (VPS) lokasi Google Chrome, mis. /usr/bin/google-chrome. Kosongkan di laptop.
CHROME_PATH=

# ===== Tampilan menu =====
# true  = sapaan pertama pakai banner gambar; false = sapaan teks saja
MENU_INTERAKTIF=true
# true  = menu dikirim sebagai polling yang bisa diketuk; false = menu angka
MENU_POLLING=true
# Gambar banner sapaan pertama
BANNER_FILE=assets/banner-selaras.jpg

# Pengaturan bot
BOT_NAME=Rara
# Radius awal pencarian faskes (meter). Otomatis diperluas jika tidak ketemu.
RADIUS_METER=3000
MAX_HASIL=5
SESSION_TIMEOUT_MENIT=30

# Kalau API key kosong, bot tetap jalan dengan mode cadangan (berbasis kata kunci).
